<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      权限与各广告平台的组件（Activity / Provider / Service）均由 library 清单合并，
      本示例无需重复声明，只声明自己的页面。
    -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.JunkCodeLibrary">

        <!-- 启动页：申请运行时权限 → 展示开屏广告 → 进入主页 -->
        <activity
            android:name=".SplashActivity"
            android:configChanges="keyboardHidden|orientation|screenSize|uiMode"
            android:exported="true"
            android:theme="@style/Theme.JunkCodeLibrary">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 主页：开屏 / 信息流广告的调用入口与日志面板 -->
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboardHidden|orientation|screenSize|uiMode"
            android:exported="false"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />

        <!-- 全广告页：进入即按 SDK 轮流加载所有形式的广告，页面只保留广告容器 -->
        <activity
            android:name=".AllAdsActivity"
            android:configChanges="keyboardHidden|orientation|screenSize|uiMode"
            android:exported="false" />
    </application>

</manifest>
